<file path="app/src/main/res/values/colors.xml">
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- =====================================================================
         Paleta de marca SIMONA — portada 1:1 desde las variables CSS de
         simulador/servidor_simulado.py (DASHBOARD_HTML :root).
         Tierra / agua / cultivo, sin colores "genéricos" de plantilla salvo
         el rojo reservado a alertas críticas.
         Fase 5.1 del plan de unificación visual.
         ===================================================================== -->

    <!-- Azul — tecnología / agua -->
    <color name="simona_azul">#1A6FA8</color>
    <color name="simona_azul_oscuro">#0F4C73</color>
    <color name="simona_azul_suave">#E7F1F8</color>

    <!-- Verde — cultivo -->
    <color name="simona_verde">#3F6B17</color>
    <color name="simona_verde_claro">#6FA330</color>
    <color name="simona_verde_suave">#EEF4E4</color>

    <!-- Marrón — tierra -->

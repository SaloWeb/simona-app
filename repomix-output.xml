<file path="app/src/main/res/layout/activity_datos_huerta.xml">
<?xml version="1.0" encoding="utf-8"?>
<!--
    Paso 3 del flujo de creación de huerta (sección 14.1 y 14.4). Recibe los
    rangos confirmados en D.2 (vía extras del Intent) y pide nombre,
    contraseña de red y, opcionalmente, la posición del marcador en un
    croquis genérico (14.4, "Ubicá tu huerta en el mapa").
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A75B3"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/datos_huerta_titulo"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nombre -->
            <TextView style="@style/RangoTitulo" android:text="@string/label_nombre_huerta" />
            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_nombre_huerta"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="@color/simona_dark_gray" />
            <TextView
                android:id="@+id/tvErrorNombre"
                style="@style/RangoAviso"
                android:text="@string/error_nombre_huerta_vacio"
                android:visibility="gone" />

            <!-- Red WiFi (SSID fijo, sección 14.4: no editable) -->
            <TextView style="@style/RangoTitulo" android:text="@string/label_red_wifi" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ssid_fijo"
                android:textColor="#6B6B6B"
                android:textSize="13sp" />

            <TextView style="@style/RangoTitulo" android:text="@string/label_password_red" />
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_password_red"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/simona_dark_gray" />
            <TextView
                android:id="@+id/tvErrorPassword"
                style="@style/RangoAviso"
                android:text="@string/error_password_corta"
                android:visibility="gone" />

            <!-- Foto de la huerta (opcional) — Fase 6.4: si se elige, se
                 usa en el mapa compartido en vez del rectángulo de color
                 del bancal. -->
            <TextView style="@style/RangoTitulo" android:text="@string/label_foto_huerta" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_bancal">

                    <ImageView
                        android:id="@+id/ivFotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/label_foto_huerta" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFotoHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hint_foto_huerta"
                        android:textColor="#6B6B6B"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnElegirFoto"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:minWidth="0dp"
                        android:text="@string/btn_elegir_foto"
                        android:textColor="@color/simona_blue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuitarFoto"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:minWidth="0dp"
                        android:text="@string/btn_quitar_foto"
                        android:textColor="@color/simona_rojo"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- Ubicación opcional en croquis genérico -->
            <TextView style="@style/RangoTitulo" android:text="@string/label_ubicacion_mapa" />
            <FrameLayout
                android:id="@+id/croquis"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:background="@color/simona_light_gray">

                <TextView
                    android:id="@+id/tvCroquisHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/hint_croquis"
                    android:textColor="#6B6B6B"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/marcador"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/marker_huerta"
                    android:visibility="gone" />

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/simona_blue"
                android:text="@string/guardar_y_continuar"
                android:textAllCaps="false"
                android:textColor="@color/simona_white"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
</file>

<file path="app/src/main/res/layout/activity_detalle_huerta.xml">
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simona_blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado: volver + nombre/categoría de la huerta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="22sp"
                android:textColor="@color/simona_tinta"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Volver" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombreHuerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/simona_tinta"
                    tools:text="Huerta del fondo" />

                <TextView
                    android:id="@+id/txtCategoriaHuerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/simona_tinta_suave"
                    android:paddingTop="2dp"
                    tools:text="Hoja" />

            </LinearLayout>

        </LinearLayout>

        <!-- Estado vacío: todavía no llegó ninguna lectura de esta huerta -->
        <LinearLayout
            android:id="@+id/estadoSinLecturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_huerta"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todavía no hay lecturas de esta huerta."
                android:textSize="14sp"
                android:textColor="@color/simona_tinta"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Conectate al dispositivo desde el dashboard en vivo para empezar a registrar datos."
                android:textSize="12sp"
                android:textColor="@color/simona_tinta_suave"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrADashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ir al dashboard en vivo"
                app:backgroundTint="@color/simona_azul"
                android:textColor="@color/simona_on_color" />

        </LinearLayout>

        <!-- Contenido: mini-mapa multicapa + depósito de agua + última actualización -->
        <LinearLayout
            android:id="@+id/contenidoConLecturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_huerta"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mapa de métricas"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/simona_tinta_suave"
                    android:paddingBottom="12dp" />

                <com.simona.app.MiniMapaCapasView
                    android:id="@+id/miniMapaCapas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_huerta"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tanque" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Depósito de agua"
                        android:textSize="12sp"
                        android:textColor="@color/simona_tinta_suave" />

                    <TextView
                        android:id="@+id/txtTanqueAgua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/simona_tinta"
                        tools:text="85%" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtRiegoActivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Riego apagado" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtUltimaActualizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/simona_tinta_suave"
                android:gravity="center"
                android:paddingTop="12dp"
                tools:text="Última lectura: hace 8s" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
</file>

<file path="app/src/main/res/layout/activity_mapa_huertas.xml">
<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A75B3"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIMONA"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Panel de huertas inteligentes"
                            android:textColor="#E0F0FA"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNuevaHuerta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/simona_green"
                        android:text="@string/nueva_huerta"
                        android:textAllCaps="false"
                        android:textColor="@color/simona_dark_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/resumenChipsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_chip_resumen"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvChipTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/simona_dark_gray"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Total"
                            android:textColor="#6B6B6B"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_chip_resumen"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvChipConSed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#C23B3B"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Con sed"
                            android:textColor="#6B6B6B"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_chip_resumen"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvChipOptimas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/simona_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Óptimas"
                            android:textColor="#6B6B6B"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_chip_resumen"
                    android:padding="4dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabBtnLista"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E7F1F8"
                        android:text="Tarjetas"
                        android:textAllCaps="false"
                        android:textColor="@color/simona_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabBtnMapa"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Croquis General"
                        android:textAllCaps="false"
                        android:textColor="#6B6B6B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/estadoVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="40dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_vacio_titulo"
                        android:textColor="@color/simona_dark_gray"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/home_vacio_texto"
                        android:textColor="#6B6B6B"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNuevaHuertaVacio"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/simona_blue"
                        android:text="@string/crear_primera_huerta"
                        android:textAllCaps="false"
                        android:textColor="@color/simona_white"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/seccionLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tvContadorHuertas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tus huertas"
                        android:textColor="@color/simona_dark_gray"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/listaHeatmapsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/seccionMapa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/mapaContainer"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:background="@drawable/bg_terreno_croquis" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:text="Toca una huerta para ver su estado y conectarte"
                        android:textColor="#6B6B6B"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAiSimona"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:backgroundTint="@color/simona_green"
        android:src="@drawable/ic_ai_chat"
        app:tint="@color/simona_dark_gray"
        app:elevation="6dp"
        android:contentDescription="Asistente Simona IA" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
</file>


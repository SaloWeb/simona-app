<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos para Android 12+ (API 31+), que reemplazan
    a full-backup-content en versiones nuevas. Mismo criterio: excluir
    "simona_huertas" tanto del backup en la nube (cloud-backup) como de la
    transferencia dispositivo-a-dispositivo (device-transfer), porque guarda
    contraseñas WiFi en texto plano.
    Ver PLAN_MEJORAS_20.md, punto 3.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="simona_huertas.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="simona_huertas.xml" />
    </device-transfer>
</data-extraction-rules>

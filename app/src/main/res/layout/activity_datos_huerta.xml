<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simona_superficie"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="@dimen/simona_space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Volver"
                    android:focusable="true"
                    android:padding="@dimen/simona_space_xs"
                    android:src="@drawable/ic_volver"
                    app:tint="@color/simona_on_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/datos_huerta_titulo"
                    android:textAppearance="@style/TextAppearance.Simona.HeaderTitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/simona_space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_resumen"
                android:orientation="vertical"
                android:padding="@dimen/simona_space">

                <TextView
                    style="@style/RangoTitulo"
                    android:text="@string/label_nombre_huerta" />

                <!-- PLAN_MEJORAS_VISUAL_2.md, punto 6: antes esta caja tenía
                     hintEnabled (default true) además del TextView fijo de
                     arriba ("Nombre de la huerta") — el hint interno
                     ("Ej: Huerta del fondo") flotaba al borde de la caja al
                     escribir, y quedaban dos líneas de texto chico apiladas
                     que parecían la misma etiqueta repetida (confirmado con
                     uiautomator dump). Con hintEnabled="false" el hint deja
                     de flotar y queda como placeholder simple (desaparece
                     al escribir, nunca compite con el label fijo). -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space_xs"
                    app:boxStrokeColor="@color/simona_azul"
                    app:hintTextColor="@color/simona_tinta_suave"
                    app:hintEnabled="false"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_nombre_huerta"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textColor="@color/simona_tinta" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvErrorNombre"
                    style="@style/RangoAviso"
                    android:text="@string/error_nombre_huerta_vacio"
                    android:visibility="gone" />

                <TextView
                    style="@style/RangoTitulo"
                    android:layout_marginTop="18dp"
                    android:text="@string/label_red_wifi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space_xs"
                    android:text="@string/ssid_fijo"
                    android:textColor="@color/simona_tinta_suave"
                    android:textSize="13sp" />

                <TextView
                    style="@style/RangoTitulo"
                    android:layout_marginTop="18dp"
                    android:text="@string/label_password_red" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space_xs"
                    app:boxStrokeColor="@color/simona_azul"
                    app:hintTextColor="@color/simona_tinta_suave"
                    app:hintEnabled="false"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/simona_tinta_suave"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_password_red"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/simona_tinta" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvErrorPassword"
                    style="@style/RangoAviso"
                    android:text="@string/error_password_corta"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_chip_resumen"
                android:orientation="vertical"
                android:padding="@dimen/simona_space">

                <TextView
                    style="@style/RangoTitulo"
                    android:text="@string/label_foto_huerta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- PLAN_MEJORAS_VISUAL_2.md, punto 7: antes esta caja
                         era un rectángulo completamente vacío sin ningún
                         ícono que sugiriera "tocá para elegir una foto"
                         (confirmado en captura real). ivFotoPlaceholderIcono
                         se oculta/muestra en DatosHuertaActivity.kt en los
                         mismos puntos donde ya se togglea ivFotoPreview. -->
                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_bancal">

                        <ImageView
                            android:id="@+id/ivFotoPlaceholderIcono"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_camara"
                            app:tint="@color/simona_tinta_suave" />

                        <ImageView
                            android:id="@+id/ivFotoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/label_foto_huerta"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/simona_space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFotoHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_foto_huerta"
                            android:textColor="@color/simona_tinta_suave"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnElegirFoto"
                            style="@style/Widget.Simona.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="@dimen/simona_space_xs"
                            android:text="@string/btn_elegir_foto"
                            android:textColor="@color/simona_azul" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuitarFoto"
                            style="@style/Widget.Simona.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="@dimen/simona_space_xxs"
                            android:text="@string/btn_quitar_foto"
                            android:textColor="@color/simona_rojo"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/RangoTitulo"
                    android:layout_marginTop="18dp"
                    android:text="@string/label_ubicacion_mapa" />

                <FrameLayout
                    android:id="@+id/croquis"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_terreno_croquis">

                    <!-- PLAN_MEJORAS_VISUAL_2.md, punto 7: mismo criterio
                         que el placeholder de foto — un ícono de pin sobre
                         el texto de ayuda, en vez de una caja vacía. Es
                         puramente decorativo (no se togglea): cuando se fija
                         un marcador real (mostrarMarcador() en
                         DatosHuertaActivity.kt), tvCroquisHint pasa a GONE
                         y con él este ícono, que vive en el mismo
                         LinearLayout. -->
                    <LinearLayout
                        android:id="@+id/grupoCroquisHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginBottom="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_pin_ubicacion"
                            app:tint="@color/simona_tinta_suave" />

                        <TextView
                            android:id="@+id/tvCroquisHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_croquis"
                            android:textColor="@color/simona_tinta_suave"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/marcador"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|start"
                        android:background="@drawable/marker_huerta"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Widget.Simona.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/simona_space_xl"
                android:text="@string/guardar_y_continuar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>


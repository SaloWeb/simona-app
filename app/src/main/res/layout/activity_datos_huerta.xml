<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simona_superficie"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/datos_huerta_titulo"
                android:textAppearance="@style/TextAppearance.Simona.HeaderTitle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_resumen"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/RangoTitulo"
                    android:text="@string/label_nombre_huerta" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/simona_azul"
                    android:hint="@string/hint_nombre_huerta"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/simona_tinta"
                    android:textColorHint="@color/simona_tinta_suave" />

                <TextView
                    android:id="@+id/tvErrorNombre"
                    style="@style/RangoAviso"
                    android:text="@string/error_nombre_huerta_vacio"
                    android:visibility="gone" />

                <TextView
                    style="@style/RangoTitulo"
                    android:layout_marginTop="18dp"
                    android:text="@string/label_red_wifi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ssid_fijo"
                    android:textColor="@color/simona_tinta_suave"
                    android:textSize="13sp" />

                <TextView
                    style="@style/RangoTitulo"
                    android:layout_marginTop="18dp"
                    android:text="@string/label_password_red" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/simona_azul"
                    android:hint="@string/hint_password_red"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/simona_tinta"
                    android:textColorHint="@color/simona_tinta_suave" />

                <TextView
                    android:id="@+id/tvErrorPassword"
                    style="@style/RangoAviso"
                    android:text="@string/error_password_corta"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_chip_resumen"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/RangoTitulo"
                    android:text="@string/label_foto_huerta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_bancal">

                        <ImageView
                            android:id="@+id/ivFotoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/label_foto_huerta"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFotoHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_foto_huerta"
                            android:textColor="@color/simona_tinta_suave"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnElegirFoto"
                            style="@style/Widget.Simona.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_elegir_foto"
                            android:textColor="@color/simona_azul" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuitarFoto"
                            style="@style/Widget.Simona.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:text="@string/btn_quitar_foto"
                            android:textColor="@color/simona_rojo"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/RangoTitulo"
                    android:layout_marginTop="18dp"
                    android:text="@string/label_ubicacion_mapa" />

                <FrameLayout
                    android:id="@+id/croquis"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_terreno_croquis">

                    <TextView
                        android:id="@+id/tvCroquisHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/hint_croquis"
                        android:textColor="@color/simona_tinta_suave"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/marcador"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|start"
                        android:background="@drawable/marker_huerta"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Widget.Simona.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/guardar_y_continuar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>


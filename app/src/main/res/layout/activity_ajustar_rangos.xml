<?xml version="1.0" encoding="utf-8"?>
<!--
    Paso 2 del flujo de creación de huerta (sección 14.3 del Plan de
    Desarrollo). Precarga los 4 rangos del perfil elegido en D.1 sobre
    sliders dobles (min–max). Arranca mostrando solo el resumen + botón
    "Usar valores recomendados"; el link "Ajustar manualmente" despliega
    los sliders y los campos de texto para edición fina.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/simona_superficie"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header"
            android:padding="@dimen/simona_space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Volver"
                    android:focusable="true"
                    android:padding="@dimen/simona_space_xs"
                    android:src="@drawable/ic_volver"
                    app:tint="@color/simona_on_color" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/ajustar_rangos_titulo"
                    android:textAppearance="@style/TextAppearance.Simona.HeaderTitle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:id="@+id/ivPerfilIcono"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        tools:src="@drawable/ic_perfil_fruto" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPerfilNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/simona_on_header_muted"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Fruto" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bloque "usar recomendados" vs "ajustar manualmente" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/simona_space_lg">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUsarRecomendados"
                style="@style/Widget.Simona.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/usar_valores_recomendados" />

            <TextView
                android:id="@+id/linkAjustarManualmente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:padding="6dp"
                android:text="@string/ajustar_manualmente"
                android:textColor="@color/simona_azul"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- PLAN_MEJORAS_VISUAL_2.md, punto 2: antes, en el estado
                 inicial (antes de tocar "Ajustar manualmente"), la pantalla
                 solo mostraba el botón + el link de arriba y nada más —
                 confirmado en captura real: el contenido terminaba en
                 y≈530 de 1650, ~60% de la pantalla en blanco. Este resumen
                 en modo lectura de los 4 rangos del perfil (los mismos
                 valores que ya trae "Usar valores recomendados") llena ese
                 espacio con información útil en vez de dejarlo vacío. Se
                 oculta al entrar a modo manual (mostrarSlidersManualmente()
                 en AjustarRangosActivity.kt), donde los sliders ya muestran
                 los mismos valores de forma editable. -->
            <LinearLayout
                android:id="@+id/resumenRangos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_chip_resumen"
                android:orientation="vertical"
                android:padding="@dimen/simona_space">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resumen_rangos_titulo"
                    android:textColor="@color/simona_tinta_suave"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rango_humedad"
                        android:textColor="@color/simona_tinta"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvResumenHumedad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/simona_tinta"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="40% — 65%" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/simona_linea" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rango_ph"
                        android:textColor="@color/simona_tinta"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvResumenPh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/simona_tinta"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="6.0 — 7.0" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/simona_linea" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rango_luz"
                        android:textColor="@color/simona_tinta"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvResumenLuz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/simona_tinta"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="300 — 650 lux" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/simona_linea" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rango_temp"
                        android:textColor="@color/simona_tinta"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvResumenTemp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/simona_tinta"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="15°C — 24°C" />
                </LinearLayout>
            </LinearLayout>

            <!-- Grupo de sliders, oculto hasta tocar "Ajustar manualmente" -->
            <LinearLayout
                android:id="@+id/grupoManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/simona_space_xs"
                android:visibility="gone">

                <!-- ===== Humedad del suelo ===== -->
                <TextView style="@style/RangoTitulo" android:text="@string/rango_humedad" />
                <TextView
                    android:id="@+id/tvHumedadAviso"
                    style="@style/RangoAviso"
                    android:text="@string/aviso_ancho_minimo_humedad"
                    android:visibility="gone" />
                <LinearLayout style="@style/RangoFilaTexto">
                    <EditText
                        android:id="@+id/etHumedadMin"
                        style="@style/RangoEditText"
                        android:inputType="number" />
                    <TextView style="@style/RangoGuion" android:text="—" />
                    <EditText
                        android:id="@+id/etHumedadMax"
                        style="@style/RangoEditText"
                        android:inputType="number" />
                    <TextView style="@style/RangoUnidad" android:text="%" />
                </LinearLayout>
                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderHumedad"
                    style="@style/RangoSlider"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="1" />

                <!-- ===== pH ===== -->
                <TextView style="@style/RangoTitulo" android:text="@string/rango_ph" />
                <LinearLayout style="@style/RangoFilaTexto">
                    <EditText
                        android:id="@+id/etPhMin"
                        style="@style/RangoEditText"
                        android:inputType="numberDecimal" />
                    <TextView style="@style/RangoGuion" android:text="—" />
                    <EditText
                        android:id="@+id/etPhMax"
                        style="@style/RangoEditText"
                        android:inputType="numberDecimal" />
                    <TextView style="@style/RangoUnidad" android:text="" />
                </LinearLayout>
                <!-- PLAN_MEJORAS_VISUAL_2.md, punto 8: valueFrom/valueTo
                     acotado de 0–14 a 4.0–9.0. Los 9 perfiles de
                     PerfilesCultivo.kt van de pH 5.5 a 7.5, así que ningún
                     valor de partida queda afuera; un pH de suelo fuera de
                     4–9 no tiene sentido agronómico. Con esto el rango
                     configurable (5.5–7.5, el más angosto de los 4) ocupa
                     una porción mucho mayor del track en vez de quedar casi
                     superpuesto en el centro de una escala 0–14. -->
                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderPh"
                    style="@style/RangoSlider"
                    android:valueFrom="4.0"
                    android:valueTo="9.0"
                    android:stepSize="0.1" />

                <!-- ===== Luminosidad ===== -->
                <TextView style="@style/RangoTitulo" android:text="@string/rango_luz" />
                <LinearLayout style="@style/RangoFilaTexto">
                    <EditText
                        android:id="@+id/etLuzMin"
                        style="@style/RangoEditText"
                        android:inputType="number" />
                    <TextView style="@style/RangoGuion" android:text="—" />
                    <EditText
                        android:id="@+id/etLuzMax"
                        style="@style/RangoEditText"
                        android:inputType="number" />
                    <TextView style="@style/RangoUnidad" android:text="lux" />
                </LinearLayout>
                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderLuz"
                    style="@style/RangoSlider"
                    android:valueFrom="0"
                    android:valueTo="1000"
                    android:stepSize="10" />

                <!-- ===== Temperatura ===== -->
                <TextView style="@style/RangoTitulo" android:text="@string/rango_temp" />
                <LinearLayout style="@style/RangoFilaTexto">
                    <EditText
                        android:id="@+id/etTempMin"
                        style="@style/RangoEditText"
                        android:inputType="numberDecimal|numberSigned" />
                    <TextView style="@style/RangoGuion" android:text="—" />
                    <EditText
                        android:id="@+id/etTempMax"
                        style="@style/RangoEditText"
                        android:inputType="numberDecimal|numberSigned" />
                    <TextView style="@style/RangoUnidad" android:text="°C" />
                </LinearLayout>
                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/sliderTemp"
                    style="@style/RangoSlider"
                    android:valueFrom="-10"
                    android:valueTo="50"
                    android:stepSize="0.5" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuar"
                style="@style/Widget.Simona.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/simona_space_lg"
                android:text="@string/continuar"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
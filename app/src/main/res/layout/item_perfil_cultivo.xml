<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/simona_space_xs"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/simona_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/simona_linea"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="18dp">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_icon_circle">

            <!--
                PLAN_MEJORAS_VISUAL_2.md, punto 10: este ImageView forzaba
                app:tint="@color/simona_azul", aplastando toda la paleta
                de colores de los drawables ic_perfil_* (verde/rojo/marrón,
                pensada para que cada perfil se lea distinto) a una
                silueta plana de un solo color — la causa real de que los
                íconos fueran difíciles de identificar (confirmado
                comparando con activity_ajustar_rangos.xml, que muestra
                el mismo ic_perfil_fruto SIN tint y ahí sí se lee bien
                como fruta roja con hoja verde). Se saca el tint acá para
                que los 9 perfiles se vean con su color propio, igual que
                ya se veían en AjustarRangosActivity.
            -->
            <ImageView
                android:id="@+id/ivIconoPerfil"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                tools:src="@drawable/ic_perfil_hoja" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/simona_space_sm"
            android:gravity="center"
            android:textColor="@color/simona_tinta"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Hoja" />

        <TextView
            android:id="@+id/tvEjemplos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/simona_space_xxs"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/simona_tinta_suave"
            android:textSize="11sp"
            tools:text="Lechuga, espinaca, acelga, rúcula" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="@dimen/simona_radio_sm"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/simona_card_bg"
    app:strokeColor="@color/simona_linea"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/ivIconoPerfil"
                android:layout_width="@dimen/simona_perfil_icon"
                android:layout_height="@dimen/simona_perfil_icon"
                android:layout_gravity="center"
                android:contentDescription="@null"
                tools:src="@drawable/ic_perfil_hoja" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/simona_tinta"
            android:gravity="center"
            tools:text="Hoja" />

        <TextView
            android:id="@+id/tvEjemplos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/simona_tinta_suave"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Lechuga, espinaca, acelga, rúcula" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

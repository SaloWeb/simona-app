<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:background="@color/simona_card_bg"
    android:orientation="vertical"
    android:padding="@dimen/simona_space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_asistente_simona" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/asistente_titulo"
            android:textColor="@color/simona_tinta"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- PLAN_MEJORAS_VISUAL_2.md, punto 4: antes esta caja tenía una altura
         fija de 200dp, pensada para una conversación larga — con el
         mensaje de bienvenida solo (3 líneas) quedaban ~150px vacíos
         abajo (confirmado en captura real). Ahora arranca en wrap_content
         (se ajusta al contenido real) y DialogoChatAi.kt le pone un tope
         dinámico de altura la primera vez que el contenido lo supera, para
         que una conversación larga siga scrolleando en vez de estirar el
         diálogo fuera de la pantalla. -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chip_resumen"
        android:padding="@dimen/simona_space_sm">

        <TextView
            android:id="@+id/tvHistorialChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/asistente_bienvenida"
            android:textColor="@color/simona_tinta"
            android:textSize="13sp" />

    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBarChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/simona_space_xs"
        android:indeterminateTint="@color/simona_verde_claro"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/simona_space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etPreguntaChat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_huerta"
            android:hint="@string/asistente_hint"
            android:inputType="textCapSentences"
            android:paddingStart="@dimen/simona_space_sm"
            android:paddingEnd="@dimen/simona_space_sm"
            android:textColor="@color/simona_tinta"
            android:textColorHint="@color/simona_tinta_suave"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/simona_space_xs"
            android:backgroundTint="@color/simona_verde_claro"
            android:contentDescription="@string/enviar"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_enviar"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp"
            app:iconTint="@color/simona_on_accent" />

    </LinearLayout>

</LinearLayout>

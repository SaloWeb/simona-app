<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simona_superficie"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_icon_circle"
        android:backgroundTint="@color/simona_azul_suave">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@string/senal_wifi_descripcion"
            android:src="@drawable/ic_wifi_signal"
            app:tint="@color/simona_azul" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_resumen"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conexión WiFi"
            android:textColor="@color/simona_tinta_suave"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHuertaNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/simona_tinta"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Huerta del fondo" />

        <TextView
            android:id="@+id/tvEstadoSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/simona_tinta_suave"
            android:textSize="14sp"
            tools:text="Acercate al dispositivo de la huerta y tocá Conectar" />

        <LinearLayout
            android:id="@+id/filaSenalWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@color/simona_azul_suave"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/imgSenalWifi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/senal_wifi_descripcion"
                android:src="@drawable/ic_wifi_signal"
                app:tint="@color/simona_verde" />

            <TextView
                android:id="@+id/tvSenalWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Señal buena" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/simona_azul"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConectar"
            style="@style/Widget.Simona.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:text="@string/btn_connect" />
    </LinearLayout>
</LinearLayout>

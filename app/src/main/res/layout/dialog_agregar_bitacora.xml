<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_huerta"
    android:orientation="vertical"
    android:padding="@dimen/simona_space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/simona_verde_suave">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_brote"
                app:tint="@color/simona_verde" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/simona_space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar en la Bitácora"
                android:textColor="@color/simona_tinta"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Guardá eventos clave del ciclo de cultivo"
                android:textColor="@color/simona_tinta_suave"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/simona_linea" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Tipo de evento"
        android:textColor="@color/simona_tinta"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerTipoBitacora"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_resumen"
        android:paddingStart="@dimen/simona_space_sm"
        android:paddingEnd="@dimen/simona_space_sm" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Detalles o notas"
        android:textColor="@color/simona_tinta"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDescripcionBitacora"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_resumen"
        android:gravity="top|start"
        android:hint="Ej: Sembrado de 6 plantines, aplicado compost orgánico…"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="@dimen/simona_space_sm"
        android:textColor="@color/simona_tinta"
        android:textColorHint="@color/simona_tinta_suave"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/simona_space_lg"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarBitacora"
            style="@style/Widget.Simona.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancelar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarBitacora"
            style="@style/Widget.Simona.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="Guardar evento"
            app:icon="@drawable/ic_agregar"
            app:iconGravity="textStart"
            app:iconTint="@color/simona_on_color" />
    </LinearLayout>

</LinearLayout>

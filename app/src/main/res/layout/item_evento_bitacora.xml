<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/simona_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/simona_linea"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/contenedorIconoBitacora"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/simona_verde_suave">

            <ImageView
                android:id="@+id/ivIconoBitacora"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                tools:src="@drawable/ic_bitacora_siembra" />

            <TextView
                android:id="@+id/tvEmojiBitacora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:visibility="gone"
                tools:text="🌱" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloBitacora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/simona_tinta"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Siembra realizada" />

            <TextView
                android:id="@+id/tvDescripcionBitacora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/simona_tinta_suave"
                android:textSize="12sp"
                tools:text="Se sembraron 12 plantines de lechuga mantecosa con compost." />

            <TextView
                android:id="@+id/tvFechaBitacora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/simona_space_xxs"
                android:textColor="@color/simona_tinta_suave"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="24 ago 2026 · 14:30" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnEliminarBitacora"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/content_desc_eliminar_evento_bitacora"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            android:visibility="gone"
            app:tint="@color/simona_tinta_suave" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

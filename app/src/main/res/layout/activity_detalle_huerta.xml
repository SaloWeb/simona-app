<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simona_superficie"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/simona_space_lg"
            android:paddingTop="18dp"
            android:paddingEnd="@dimen/simona_space_lg"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Volver"
                    android:focusable="true"
                    android:padding="@dimen/simona_space_xs"
                    android:src="@drawable/ic_volver"
                    app:tint="@color/simona_on_color" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombreHuerta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/simona_on_color"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Huerta del fondo" />

                    <TextView
                        android:id="@+id/txtCategoriaHuerta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/simona_on_header_muted"
                        android:textSize="12sp"
                        tools:text="Hoja" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/simona_space">

            <LinearLayout
                android:id="@+id/bannerConectado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/simona_space_sm"
                android:background="@drawable/bg_chip_capa_seleccionado"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/simona_space"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_banner_conectado_titulo"
                        android:textColor="@color/simona_on_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/detalle_banner_conectado_desc"
                        android:textColor="@color/simona_on_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnDesconectar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/simona_space_xs"
                    android:text="@string/detalle_btn_desconectar"
                    android:textColor="@color/simona_on_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/estadoSinLecturas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_resumen"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/simona_space_xl"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/detalle_sin_lecturas_titulo"
                    android:textColor="@color/simona_tinta"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space_xs"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/detalle_sin_lecturas_desc"
                    android:textColor="@color/simona_tinta_suave"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrADashboard"
                    style="@style/Widget.Simona.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/simona_space"
                    android:text="@string/detalle_ir_dashboard" />

                <ProgressBar
                    android:id="@+id/progressEsperandoDatos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenidoConLecturas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_resumen"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/simona_space">

                    <com.simona.app.GaugeHumedadView
                        android:id="@+id/gaugeHumedad"
                        android:layout_width="200dp"
                        android:layout_height="200dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space_sm"
                    android:background="@drawable/bg_chip_resumen"
                    android:orientation="vertical"
                    android:padding="@dimen/simona_space">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="@dimen/simona_space_sm"
                        android:text="@string/detalle_mapa_metricas"
                        android:textColor="@color/simona_tinta_suave"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.simona.app.MiniMapaCapasView
                        android:id="@+id/miniMapaCapas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space_sm"
                    android:background="@drawable/bg_chip_resumen"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/simona_space">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tanque"
                        app:tint="@color/simona_azul" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detalle_deposito_agua"
                            android:textColor="@color/simona_tinta_suave"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtTanqueAgua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/simona_tinta"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="85%" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtRiegoActivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Riego apagado" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controlesEnVivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space_sm"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRiegoManual"
                        style="@style/Widget.Simona.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/detalle_riego_manual_activar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefillTanque"
                        style="@style/Widget.Simona.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/simona_space_sm"
                        android:layout_weight="1"
                        android:text="@string/detalle_btn_refill_tanque" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChatSimona"
                    style="@style/Widget.Simona.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/simona_space_sm"
                    android:text="@string/detalle_btn_chat_simona"
                    android:visibility="gone"
                    app:icon="@drawable/ic_asistente_simona"
                    app:iconGravity="textStart" />

                <LinearLayout
                    android:id="@+id/cardTendencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/simona_space_sm"
                    android:background="@drawable/bg_chip_resumen"
                    android:orientation="vertical"
                    android:padding="@dimen/simona_space"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detalle_tendencia_reciente"
                            android:textColor="@color/simona_tinta_suave"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipTendenciaHumedad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_capa_seleccionado"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="@dimen/simona_space_sm"
                            android:paddingTop="6dp"
                            android:paddingEnd="@dimen/simona_space_sm"
                            android:paddingBottom="6dp"
                            android:text="@string/detalle_chip_humedad"
                            android:textColor="@color/simona_on_color"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipTendenciaTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_capa"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="@dimen/simona_space_sm"
                            android:paddingTop="6dp"
                            android:paddingEnd="@dimen/simona_space_sm"
                            android:paddingBottom="6dp"
                            android:text="@string/detalle_chip_temp"
                            android:textColor="@color/simona_tinta"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.simona.app.GraficoTendenciaView
                        android:id="@+id/graficoTendencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/simona_space_xs" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtUltimaActualizacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="@dimen/simona_space_sm"
                    android:textColor="@color/simona_tinta_suave"
                    android:textSize="11sp"
                    tools:text="Última lectura: hace 8s" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Radio 12dp SIN cambios: coincide con .metrica { border-radius: 12px }
         del HTML, que es el análogo de estos chips resumen — no debe
         igualarse a los 16dp de bg_card_huerta, esa tarjeta más grande usa
         un radio distinto a propósito en el propio diseño original.
         Sí se actualizan los colores hardcodeados (#FFFFFF/#E4DFD6) a los
         tokens adaptativos de la Fase 5.1. -->
    <solid android:color="@color/simona_card_bg" />
    <stroke android:width="1dp" android:color="@color/simona_linea" />
    <corners android:radius="12dp" />
</shape>
